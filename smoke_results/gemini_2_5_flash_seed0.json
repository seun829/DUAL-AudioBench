    "turns": [
      {
        "role": "user",
        "text": "Hi, I am checking on my flight to Denver this afternoon.",
        "kind": "setup",
        "audio_path": "data\\turn_audio\\a2ad6e52d2b59ceeccc1abf0.wav"
      },
      {
        "role": "agent",
        "text": "I see the 2:15 departure. Is that the flight you mean?",
        "audio_path": "data\\turn_audio\\36034bba09ea71afb5f2eed1.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "Yes. I want to make sure everything is on track.",
        "kind": "setup",
        "audio_path": "data\\turn_audio\\fea7ef60ada4f32aef95193a.wav"
      },
      {
        "role": "agent",
        "text": "Is there anything else I can help you with?",
        "audio_path": "data\\turn_audio\\903884ab4cf1935be22c5867.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "No, everything else looks right.",
        "kind": "filler",
        "audio_path": "data\\turn_audio\\6823c996f651353df8469634.wav"
      },
      {
        "role": "agent",
        "text": "The security wait is about twenty minutes. Are you leaving soon?",
        "audio_path": "data\\turn_audio\\3f5817f225fb99184e83063e.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "Yes, I am heading to the airport shortly.",
        "kind": "filler",
        "audio_path": "data\\turn_audio\\82fe54f688141a0d15bb13d3.wav"
      },
      {
        "role": "agent",
        "text": "Is Denver your final destination?",
        "audio_path": "data\\turn_audio\\c0587090f74dc42d691db60d.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "Keep in mind I have another flight out of Denver, and there are only ninety minutes between them.",
        "kind": "clue",
        "audio_path": "data\\turn_audio\\13acf75b663283b17d6e3ff3.wav"
      },
      {
        "role": "agent",
        "text": "Do you have any dietary or accessibility needs for your connecting flight?",
        "audio_path": "data\\turn_audio\\9aa660efe512abe55253c100.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "No, nothing like that.",
        "kind": "filler",
        "audio_path": "data\\turn_audio\\973135bb878bbfaa2c91d71e.wav"
      },
      {
        "role": "agent",
        "text": "Are you checking any bags?",
        "audio_path": "data\\turn_audio\\bb23141b4213466b1df58149.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "Just one checked bag.",
        "kind": "filler",
        "audio_path": "data\\turn_audio\\e68b9b0f2ac963d549baf49c.wav"
      },
      {
        "role": "agent",
        "text": "Is the contact phone number on your booking current?",
        "audio_path": "data\\turn_audio\\73e08b8edcc29670b8b34f4c.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "Yes, it is current.",
        "kind": "filler",
        "audio_path": "data\\turn_audio\\129c2031731f86f514d37a9c.wav"
      },
      {
        "role": "agent",
        "text": "Do you need directions to the departure terminal?",
        "audio_path": "data\\turn_audio\\05ec8cc9aa6d7143ff5166a7.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "No, I know where to go.",
        "kind": "filler",
        "audio_path": "data\\turn_audio\\fab97d34a2e05c64f7522c68.wav"
      },
      {
        "role": "agent",
        "text": "Would you like gate-change notifications sent to your phone as a text message?",
        "audio_path": "data\\turn_audio\\3c0834d093f1fd934ec43e2b.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "Yes, that would help.",
        "kind": "filler",
        "audio_path": "data\\turn_audio\\75b8c869831f4b9363847aef.wav"
      },
      {
        "role": "agent",
        "text": "Do you already have a seat assignment?",
        "audio_path": "data\\turn_audio\\532029dec785767f32e5370c.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "Yes, fourteen C, an aisle.",
        "kind": "filler",
        "audio_path": "data\\turn_audio\\5043cd2a73c1c8137a98369d.wav"
      },
      {
        "role": "agent",
        "text": "Is the rewards number ending in 993 yours?",
        "audio_path": "data\\turn_audio\\ad906c32fa47d33c0999a34e.wav",
        "action_label": null,
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "Yes, that is mine.",
        "kind": "filler",
        "audio_path": "data\\turn_audio\\70f51d250b06144b211fa21d.wav"
      },
      {
        "role": "agent",
        "text": "I will Enable active monitoring for changes to the itinerary.",
        "audio_path": "data\\turn_audio\\7e950981f4c3fde8843a7ed1.wav",
        "action_label": "E",
        "response_style_label": null
      },
      {
        "role": "user",
        "text": "Okay, I will watch for what happens.",
        "kind": "pre_gap_acknowledgement",
        "audio_path": "data\\turn_audio\\4f41d088e622ab02f4a7738a.wav"
      },
      {
        "role": "user",
        "text": "I just got a notice that the flight is delayed 120 minutes. What should I do now?",
        "kind": "post_gap_observation",
        "audio_path": "data\\turn_audio\\7bac881ff3b4268999ebf6a3.wav",
        "prosody": "calm"
      },
      {
        "role": "agent",
        "text": "I will Protect the later segment now and offer a compatible alternative.",
        "audio_path": "data\\turn_audio\\22e5fb2166969faaceffe1b9.wav",
        "action_label": "A",
        "response_style_label": null
      }
